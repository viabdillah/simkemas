{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simkemas-backend",
	"pages_build_output_dir": "public",
	"compatibility_date": "2026-07-25",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simkemas-db",
			"database_id": "3c65fe7e-0f5d-429c-81f7-a72c2e7b35d1",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "SIMKEMAS_RATE_LIMIT",
			"id": "6f3b8154480e45a28f3653d66a96b509",
			"remote": true
		}
	]
}